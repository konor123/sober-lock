<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="맑은잠금"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="술이나 졸림에 취해 실수하지 않도록 선택한 앱을 잠급니다.\n해제는 랩/발음 테스트, 시끄러우면 점 테스트(10초)로 합니다." />

        <TextView
            android:id="@+id/tvStatusA11y"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="접근성 서비스: 확인 중"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnA11y"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="접근성 설정 열기" />

        <TextView
            android:id="@+id/tvStatusBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="배터리 최적화: 확인 중"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="배터리 최적화 제외 요청" />

        <TextView
            android:id="@+id/tvStatusMic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="마이크 권한: 확인 중"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="마이크 권한 허용" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="잠글 앱 선택"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="전화/다이얼러/119, 설정, 맑은잠금 자체는 잠글 수 없습니다." />

        <LinearLayout
            android:id="@+id/llAppList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="해제 유지 시간"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbDuration5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5분" />

            <RadioButton
                android:id="@+id/rbDuration10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10분" />

            <RadioButton
                android:id="@+id/rbDuration30"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30분" />

            <RadioButton
                android:id="@+id/rbDurationScreenOff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="화면 끌 때까지" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="점 테스트 기준 측정"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="멀쩡할 때 3회 측정해 평균 반응시간을 저장합니다. 기준이 있으면 통과 기준에 +40% 여유를 둡니다." />

        <Button
            android:id="@+id/btnBaseline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="기준 측정 시작 (3회, 각 10초)" />

        <com.ju.soberlock.DotTestView
            android:id="@+id/dotTestViewBaseline"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="8dp"
            android:background="#11000000" />

        <TextView
            android:id="@+id/tvBaselineResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="아직 기준을 측정하지 않았습니다." />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="로그"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#11000000"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:text="로그가 없습니다"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnClearLog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="로그 지우기" />

    </LinearLayout>
</ScrollView>
